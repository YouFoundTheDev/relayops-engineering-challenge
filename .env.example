# Copy to .env and adjust before running `docker compose up --build`.
# The values below are development defaults used by docker-compose.yml when no
# .env file is present. Do not use them in a shared or production deployment.
#
# Never commit a real .env file.

POSTGRES_USER=relayops
POSTGRES_PASSWORD=relayops-dev-password
POSTGRES_DB=relayops

# Shared secret used by the worker to sign webhooks and by the receiver to
# verify them. Must be identical for both services.
WEBHOOK_SECRET=relayops-dev-secret

# Internal service address; use the Docker service name, not localhost.
RECEIVER_URL=http://receiver:9000/webhook

# Worker tuning.
POLL_INTERVAL=1
PROCESSING_LEASE_SECONDS=60
RETRY_BASE_SECONDS=1

# API database pool size and log level (INFO, DEBUG, WARNING, ERROR).
DB_POOL_MAX=10
LOG_LEVEL=INFO